flowchart TB
    A["应用 / Agent<br/>提交问题、上下文、工具定义"]

    subgraph G["FreeLLMAPI：模型网关"]
        B["① 统一接入<br/>鉴权、校验、转换请求格式"]
        C["② 选择调用路线<br/>供应商 + 模型 + 密钥"]
        D["③ 适配并调用<br/>转换供应商协议、发送请求"]
        E{"调用结果"}
        F["④ 整理返回<br/>回答、流式内容、工具调用"]
        H["失败管理<br/>记录错误、冷却、检查重试预算"]
        I["返回明确错误"]

        S["路由依据<br/>人工优先级 / 动态评分<br/>模型能力 / 剩余额度 / 健康状态"]
        L["状态记录<br/>额度消耗、速度、成功与失败"]

        B --> C --> D
        S -.-> C
        E -->|成功| F
        E -->|失败| H
        H -->|允许重试且有候选| C
        H -->|无法继续| I
        E -.-> L
        L -.-> S
    end

    M["实际模型服务<br/>云供应商 / 本地模型<br/>负责推理与生成"]

    A --> B
    D --> M
    M --> E
    F --> A
    I --> A

    style G fill:#f0f6ff,stroke:#5b8bc0
    style C fill:#dbeafe,stroke:#2563eb,stroke-width:3px
    style H fill:#fff1d6,stroke:#d99a28
    style M fill:#e5f5e9,stroke:#4b9562
